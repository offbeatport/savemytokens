# ─────────────────────────────────────────────────────────────
# SaveMyTokens - environment
# Copy to .env and fill in. Everything is optional for local dev:
# the app runs end-to-end with mock data and disabled integrations.
# ─────────────────────────────────────────────────────────────

# App
APP_URL=http://localhost:3000
VITE_APP_URL=http://localhost:3000

# Database (better-sqlite3 file path)
SQLITE_PATH=./data/savemytokens.db

# Auth (better-auth)
# Generate a secret with: pnpm auth:secret
BETTER_AUTH_SECRET=dev-only-insecure-secret-change-me
BETTER_AUTH_URL=http://localhost:3000
# Google social login (leave blank to hide the Google button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin access - comma-separated emails that can reach /admin
ADMIN_EMAILS=offbeatport@gmail.com

# Payments (Polar) - leave blank to run checkout in mock mode
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=sandbox
# Per-report Polar product ids ($99 each). Any left blank → that report
# unlocks in mock mode (instant, for the demo).
POLAR_PRODUCT_ID_HEALTH=
POLAR_PRODUCT_ID_OUTPUT=
POLAR_PRODUCT_ID_CACHE=
POLAR_PRODUCT_ID_MARGIN=
POLAR_PRODUCT_ID_AGENT=
# Optional bundle (all 5 reports)
POLAR_PRODUCT_ID_BUNDLE=

# AI (OpenRouter) - used for the founder memo / narrative generation
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite-preview

# Observability
SENTRY_DSN=
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
